{
  "name": "bymr-launcher-frontend",
  "version": "0.3.7",
  "description": "A Svelte frontend application for the Backyard Monsters Refitted Launcher",
  "private": true,
  "type": "module",
  "scripts": {
    "tauri": "tauri",
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "lint": "prettier --check .",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@internationalized/date": "3.12.4",
    "@lucide/svelte": "1.59.0",
    "@sveltejs/adapter-static": "4.0.0",
    "@sveltejs/kit": "3.1.0",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@tailwindcss/vite": "4.3.3",
    "@tauri-apps/api": "2.12.1",
    "@tauri-apps/cli": "2.12.1",
    "@tauri-apps/plugin-http": "2.5.7",
    "@tauri-apps/plugin-opener": "2.7.0",
    "@tauri-apps/plugin-os": "2.3.2",
    "@tauri-apps/plugin-process": "2.3.1",
    "@tauri-apps/plugin-updater": "2.10.0",
    "bits-ui": "2.19.5",
    "prettier": "3.9.10",
    "prettier-plugin-svelte": "4.1.1",
    "svelte": "5.57.2",
    "svelte-check": "4.7.7",
    "tailwind-merge": "3.5.0",
    "tailwind-variants": "3.3.1",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vite": "8.3.4",
    "zod": "4.6.7"
  },
  "imports": {
    "#lib/*": "./src/lib/*"
  },
  "overrides": {
    "runed": {
      "@sveltejs/kit": "$@sveltejs/kit"
    }
  }
}
