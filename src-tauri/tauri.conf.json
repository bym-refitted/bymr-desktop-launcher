{
  "productName": "bymr-launcher",
  "version": "1.0.1",
  "build": {
    "beforeBuildCommand": "npm run build",
    "beforeDevCommand": "npm run dev",
    "frontendDist": "../build",
    "devUrl": "http://localhost:5173"
  },
  "bundle": {
    "active": true,
    "category": "DeveloperTool",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "depends": ["libgtk2.0-0"]
      }
    },
    "createUpdaterArtifacts": true
  },
  "mainBinaryName": "bymr-launcher",
  "identifier": "com.bymr.launcher",
  "plugins": {
    "updater": {
      "windows": {
        "installMode": "passive"
      },
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEJBQzY1N0EzQzJCRUNBQzkKUldUSnlyN0NvMWZHdXB3dml4WGNvdHdRZVZraWpkVks0UVhHVTZvMlkvSjBlZlRQOGd1RVMxRk0K",
      "endpoints": [
        "https://gist.github.com/React1-X/30d54091783e2434d697e557606ed70a/raw"
      ]
    }
  },
  "app": {
    "windows": [
      {
        "title": "Backyard Monsters: Refitted | Launcher",
        "fullscreen": false,
        "resizable": true,
        "width": 1280,
        "height": 720,
        "center": true,
        "minWidth": 1000,
        "minHeight": 600,
        "backgroundColor": "#1d232a",
        "decorations": false
      }
    ],
    "security": {
      "csp": null
    }
  }
}
